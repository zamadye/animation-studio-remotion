{
  "fps": 24,
  "duration": 1344,
  "audioSeconds": 56.0,
  "audio": "audio/gajian-part2/VO-PART-02.mp3",
  "sha256": "d9eee66702917b4f87819e71ea529c56d3053a9cae4bf4c0f7890bba6b251494",
  "cues": [
    {
      "id": 1,
      "start": 0.17,
      "end": 9.53,
      "sourceText": "Malamnya gue ambil buku, gue catat semua pengelaran gue, yang gak penting gue chorep, jajan kopi berhenti, beli makan siang gue ganti bawah bakal."
    },
    {
      "id": 2,
      "start": 9.53,
      "end": 13.45,
      "sourceText": "Kalo ada barang yang masih bisa dipakai, ya udah gak usah beli baru."
    },
    {
      "id": 3,
      "start": 13.45,
      "end": 23.51,
      "sourceText": "Awalnya gue lumayan semangat, karena tiap hari ada aja uang yang berhasil gue sisi hin, lima ribu, 10 ribu, kadang 15 ribu, kelihatannya kecil."
    },
    {
      "id": 4,
      "start": 23.51,
      "end": 31.15,
      "sourceText": "Tapi gue pikir kalau dikumpulin sebulan, lumayan juga, hari hari berikutnya gue masih ngelakuin hal yang sama."
    },
    {
      "id": 5,
      "start": 31.15,
      "end": 36.22,
      "sourceText": "Pagi kerja, siang makan bekal, sore pulang, malam nyatet pengluaran."
    },
    {
      "id": 6,
      "start": 36.22,
      "end": 44.61,
      "sourceText": "Pernah temen kantor ngajak makan barang, gue nolak, bukan karena gak penting, gue cuma lagi berusaha supaya bulan ini gak seperti bulan kemarin."
    },
    {
      "id": 7,
      "start": 44.61,
      "end": 50.19,
      "sourceText": "Istri gue sampai beberapa kali ngingetin, jangan terlalu maksa, tapi gue tetep jalanin."
    },
    {
      "id": 8,
      "start": 50.19,
      "end": 55.99,
      "sourceText": "Karena gue pengen buktikin satu hal, kalau gue lebih disiplin, mungkin keadaan gue bisa berubah."
    }
  ],
