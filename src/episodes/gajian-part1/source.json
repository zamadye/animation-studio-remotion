{
  "fps": 24,
  "duration": 1786,
  "audioSeconds": 74.4,
  "audio": "audio/gajian-part1/VO-PART-01.mp3",
  "sha256": "61c9296e285035579a2c71f016a704ff7b45829a7d50f44b6d43c605b73b3e41",
  "cues": [
    {
      "id": 1,
      "start": 0.11,
      "end": 4.47,
      "sourceText": "Kalau jaman sekarang lu masih miskin, berarti ada yang salah sama diri lu."
    },
    {
      "id": 2,
      "start": 4.47,
      "end": 8.0,
      "sourceText": "Itu kalimat yang gue dengar dari seorang influencer pagi ini."
    },
    {
      "id": 3,
      "start": 8.0,
      "end": 10.81,
      "sourceText": "Katanya, sekarang peluang ada dimana-mana."
    },
    {
      "id": 4,
      "start": 10.81,
      "end": 12.41,
      "sourceText": "Mau belajar apa aja bisa?"
    },
    {
      "id": 5,
      "start": 12.41,
      "end": 14.37,
      "sourceText": "Mau cari uang tambahan juga bisa?"
    },
    {
      "id": 6,
      "start": 14.37,
      "end": 16.67,
      "sourceText": "Tinggal kita nya mau usaha atau nggak?"
    },
    {
      "id": 7,
      "start": 16.67,
      "end": 18.06,
      "sourceText": "Gue sempet mikir."
    },
    {
      "id": 8,
      "start": 18.06,
      "end": 20.03,
      "sourceText": "Apa ya gue yang kurang usaha?"
    },
    {
      "id": 9,
      "start": 20.03,
      "end": 24.83,
      "sourceText": "Soalnya gue kerja hampir kayak pari, berangkat pagi, pulang kadang udah malam."
    },
    {
      "id": 10,
      "start": 24.83,
      "end": 29.47,
      "sourceText": "Tapi entah kenapa, setiap akhir bulan, gue selalu kembali ke masalah yang sama."
    },
    {
      "id": 11,
      "start": 29.47,
      "end": 30.42,
      "sourceText": "Uang."
    },
    {
      "id": 12,
      "start": 30.42,
      "end": 32.18,
      "sourceText": "Hari itu kebetulan tanggal satu."
    },
    {
      "id": 13,
      "start": 32.18,
      "end": 35.18,
      "sourceText": "Gaji gue baru masuk, 3 juta 200 ribu."
    },
    {
      "id": 14,
      "start": 35.18,
      "end": 40.14,
      "sourceText": "Belum sempet gue senang, gue langsung ingat cichilan motor, 850 ribu."
    },
    {
      "id": 15,
      "start": 40.14,
      "end": 42.98,
      "sourceText": "Terus pinjaman lama, 420 ribu."
    },
    {
      "id": 16,
      "start": 42.98,
      "end": 44.46,
      "sourceText": "Contrakan 1 juta."
    },
    {
      "id": 17,
      "start": 44.46,
      "end": 48.3,
      "sourceText": "Listrik, air sama kebutuhan dapur, hampir 1 juta lagi."
    },
    {
      "id": 18,
      "start": 48.3,
      "end": 53.86,
      "sourceText": "Belum bensin, belum kebutuhan mendadak, dan masih ada uang yang tiap bulan gue sisi hin buat ibu gue."
    },
    {
      "id": 19,
      "start": 53.86,
      "end": 55.1,
      "sourceText": "Gue hitung sekali."
    },
    {
      "id": 20,
      "start": 55.1,
      "end": 56.5,
      "sourceText": "Terus gue hitung lagi."
    },
    {
      "id": 21,
      "start": 56.5,
      "end": 58.06,
      "sourceText": "Angkanya tetap sama."
    },
    {
      "id": 22,
      "start": 58.06,
      "end": 61.78,
      "sourceText": "Dari dapur, istri gue nanya, apakah bulan ini uangnya cukup?"
    },
    {
      "id": 23,
      "start": 61.78,
      "end": 65.74,
      "sourceText": "Gue pengen jawab aman, tapi gue sendiri gak yakin."
    },
    {
      "id": 24,
      "start": 65.74,
      "end": 71.16,
      "sourceText": "Akhirnya gue cuma bilang, kayaknya bulan ini kita harus lebih hemat lagi."
    },
    {
      "id": 25,
      "start": 71.16,
      "end": 74.32,
      "sourceText": "Padahal gue tau, masalahnya gak sesedar hanah hemat."
    }
  ],
