  "model": "eleven_v3",
  "lines": [
    {
      "speaker": "nisa",
      "text": "Kamu boros apa gimana sih? Gaji baru masuk udah habis!"
    },
    {
      "speaker": "raka",
      "text": "Aku nggak jajan, nggak nongkrong. Makan siang aja bawa bekal."
    },
    {
      "speaker": "nisa",
      "text": "Terus uangnya ke mana?"
    },
    {
      "speaker": "raka",
      "text": "Aku juga kirim lima ratus ribu buat Ibu."
    },
    {
      "speaker": "nisa",
      "text": "Kenapa nggak bilang?"
    },
    {
      "speaker": "raka",
      "text": "Takut kamu marah."
    },
    {
      "speaker": "nisa",
      "text": "Aku bukan marah karena kamu bantu Ibu. Aku marah karena kamu bohong soal uang kita."
    }
  ],
