{
  "fingerprint": "09104dfd196f447f8c385848ba33897c006ccb39b734dbb01d8ee7eab7ab8b88",
  "voices": {
    "raka": "JBFqnCBsd6RMkjVDRZzb",
    "nisa": "21m00Tcm4TlvDq8ikWAM"
  },
  "model": "eleven_v3",
  "lines": [
    {
      "speaker": "raka",
      "text": "Jadi... kalau semuanya dibayar, kita malah minus."
    },
    {
      "speaker": "nisa",
      "text": "Berarti selama ini masalahnya bukan cuma kita boros."
    },
    {
      "speaker": "raka",
      "text": "Iya. Uangnya memang nggak cukup."
    },
    {
      "speaker": "nisa",
      "text": "Terus gimana sekarang?"
    },
    {
      "speaker": "raka",
      "text": "Mulai sekarang kita hitung bareng. Nggak ada yang disembunyiin lagi."
    },
    {
      "speaker": "nisa",
      "text": "Oke. Tapi sekarang kita makan apa?"
    },
    {
      "speaker": "raka",
      "text": "Kita masih punya telur, kan?"
    },
    {
      "speaker": "nisa",
      "text": "Satu."
    },
    {
      "speaker": "raka",
      "text": "Bagus. Berarti masing-masing setengah."
    },
    {
      "speaker": "nisa",
      "text": "Mas... itu telur buat besok."
    }
  ],
