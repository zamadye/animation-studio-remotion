{
  "fingerprint": "aa407dd77c04e9f512e604883242df459e7d4af946627c43d152af9b223bbf23",
  "voices": {
    "raka": "JBFqnCBsd6RMkjVDRZzb",
    "nisa": "21m00Tcm4TlvDq8ikWAM"
  },
  "model": "eleven_v3",
  "lines": [
    {
      "speaker": "raka",
      "text": "Alhamdulillah! Gajian juga. Tiga juta dua ratus!"
    },
    {
      "speaker": "raka",
      "text": "Oke... dipotong delapan ratus lima puluh."
    },
    {
      "speaker": "raka",
      "text": "Lah, empat ratus dua puluh juga hari ini?"
    },
    {
      "speaker": "nisa",
      "text": "Mas, udah gajian?"
    },
    {
      "speaker": "raka",
      "text": "Udah, Sayang."
    },
    {
      "speaker": "nisa",
      "text": "Bagus. Kontrakan satu juta, listrik sama air dua ratus lima puluh, belanja dapur tujuh ratus."
    },
    {
      "speaker": "raka",
      "text": "Nis..."
    },
    {
      "speaker": "nisa",
      "text": "Kenapa?"
    },
    {
      "speaker": "raka",
      "text": "Kalau bulan ini kita nggak makan dulu, gimana?"
    },
    {
      "speaker": "nisa",
      "text": "Mas! Ini baru tanggal satu!"
    }
  ],
